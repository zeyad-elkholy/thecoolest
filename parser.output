Grammar

    0 $accept: program $end

    1 program: class_list

    2 class_list: class_def ';'
    3           | class_list class_def ';'

    4 class_def: CLASS TYPE inherits '{' feature_list '}'

    5 inherits: INHERITS TYPE
    6         | ε

    7 feature_list: ε
    8             | feature_list feature ';'

    9 feature: ID '(' opt_formals ')' ':' TYPE '{' expr '}'
   10        | ID ':' TYPE opt_init

   11 opt_init: ASSIGN expr
   12         | ε

   13 opt_formals: ε
   14            | formal_list

   15 formal_list: formal
   16            | formal_list ',' formal

   17 formal: ID ':' TYPE

   18 expr: ID ASSIGN expr
   19     | expr AT TYPE '.' ID '(' opt_expr_list ')'
   20     | expr '.' ID '(' opt_expr_list ')'
   21     | expr '+' expr
   22     | expr '-' expr
   23     | expr '*' expr
   24     | expr '/' expr
   25     | expr '<' expr
   26     | expr LE expr
   27     | expr '=' expr
   28     | block
   29     | '~' expr
   30     | '(' expr ')'
   31     | NEW TYPE
   32     | ID '(' opt_expr_list ')'
   33     | IF expr THEN expr ELSE expr FI
   34     | WHILE expr LOOP expr POOL
   35     | LET let_list IN expr
   36     | CASE expr OF case_expr_list ESAC
   37     | ISVOID expr
   38     | NOT expr
   39     | TRUE
   40     | FALSE
   41     | INT_CONST
   42     | STR_CONST
   43     | ID

   44 block: '{' block_exprs '}'

   45 block_exprs: expr ';'
   46            | block_exprs expr ';'

   47 opt_expr_list: ε
   48              | expr_list

   49 expr_list: expr
   50          | expr_list ',' expr

   51 case_expr_list: case_branch
   52               | case_expr_list case_branch

   53 case_branch: ID ':' TYPE DARROW expr ';'

   54 let_list: let_bind
   55         | let_list ',' let_bind

   56 let_bind: ID ':' TYPE opt_init


